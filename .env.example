# ============================================
# MindGallery 统一环境变量配置示例
# ============================================

# 应用基础配置
NODE_ENV=development
PORT=3000
CORS_ORIGIN=true

# 数据库配置 (PostgreSQL + pgvector)
DATABASE_URL=postgresql://admin:password@localhost:5432/mindgallery

# AI服务配置 (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=moondream:latest

# 存储配置 (选择一种存储方式)
# 方式A: 本地文件存储
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# 方式B: MinIO对象存储 (推荐)
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=images
MINIO_USE_SSL=false

# 前端配置
VITE_API_BASE_URL=http://localhost:3000
VITE_BASE_URL=/