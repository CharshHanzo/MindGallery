{
  "name": "mindgallery",
  "version": "1.0.0",
  "private": true,
  "description": "MindGallery - AI图像分析应用",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"FRONTEND,BACKEND,ELECTRON\" -c \"bgBlue.bold,bgGreen.bold,bgYellow.bold\" \"npm run dev:frontend\" \"npm run dev:backend\" \"wait-on tcp:5175 && npm run dev:electron\"",
    "dev:legacy": "concurrently -n \"Docker,前端,后端,AI服务\" -c \"bgRed.bold,bgBlue.bold,bgGreen.bold,bgMagenta.bold\" \"npm run docker:up\" \"npm run dev:frontend\" \"npm run dev:legacy-backend\" \"npm run dev:clip\"",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:backend": "npm run dev -w packages/desktop-backend",
    "dev:legacy-backend": "cd packages/backend && npm run dev",
    "dev:clip": "cd packages/clip-service && .\\venv\\Scripts\\python.exe clip_vector_service.py",
    "dev:electron": "npm run dev -w packages/desktop-electron",
    "build": "npm run build --workspaces",
    "install:all": "npm install",
    "lint": "npm run lint --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "wait-on": "^8.0.5"
  },
  "keywords": [
    "vue",
    "fastify",
    "pgvector",
    "ai"
  ],
  "author": "Your Name",
  "license": "MIT"
}
