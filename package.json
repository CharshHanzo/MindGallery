{
  "name": "mindgallery",
  "version": "1.0.0",
  "private": true,
  "description": "MindGallery - AI图像分析应用",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"前端,后端\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "install:all": "npm install",
    "lint": "npm run lint --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": ["vue", "fastify", "ollama", "pgvector", "ai"],
  "author": "Your Name",
  "license": "MIT"
}