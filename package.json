{
  "name": "mindgallery",
  "version": "1.0.0",
  "private": true,
  "description": "MindGallery - AI图像分析应用",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"Docker,前端,后端\" -c \"bgRed.bold,bgBlue.bold,bgGreen.bold\" \"npm run docker:up\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "dev:backend": "cd packages/backend && npm run dev",
    "build": "npm run build --workspaces",
    "install:all": "npm install",
    "lint": "npm run lint --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": ["vue", "fastify", "ollama", "pgvector", "ai"],
  "author": "Your Name",
  "license": "MIT"
}