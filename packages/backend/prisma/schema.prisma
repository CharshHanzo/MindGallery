generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id          String     @id @default(cuid())
  filename    String
  objectKey   String
  storageType String     @default("minio")
  bucketName  String?
  fileSize    Int
  mimeType    String
  uploadTime  DateTime   @default(now())
  description String?
  tags        String[]
  vector      Float[]
  width       Int?
  height      Int?
  cameraModel String?
  location    String?
  takenTime   DateTime?
  imageTags   ImageTag[]
  imageAlbums ImageAlbum[]

  @@index([uploadTime])
  @@index([tags])
}

model Tag {
  id          String     @id @default(cuid())
  name        String     @unique
  count       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  description String?
  category    String?
  isActive    Boolean    @default(true)
  imageTags   ImageTag[]

  @@index([name])
  @@index([count])
}

model ImageTag {
  id        String   @id @default(cuid())
  imageId   String
  tagId     String
  createdAt DateTime @default(now())
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([imageId, tagId])
  @@index([imageId])
  @@index([tagId])
}

model Album {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  imageAlbums ImageAlbum[]

  @@index([name])
}

model ImageAlbum {
  id        String   @id @default(cuid())
  imageId   String
  albumId   String
  createdAt DateTime @default(now())
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([imageId, albumId])
  @@index([imageId])
  @@index([albumId])
}
